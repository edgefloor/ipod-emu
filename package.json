{
  "name": "ipod-emu",
  "version": "0.2.0",
  "private": true,
  "description": "A classic iPod simulator with a click wheel, demo audio, Brick, and optional Apple Music playback.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx scripts/serve.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsx scripts/build.ts",
    "verify": "pnpm run check && pnpm test && pnpm run build",
    "token": "tsx scripts/generate-developer-token.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
